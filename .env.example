# Everything runs offline by default (hashing embeddings, extractive answerer).
API_PORT=8000
POSTGRES_PASSWORD=rag

# Providers: RAG_EMBEDDER=hashing|fastembed|openai_compatible, RAG_LLM=extractive|openai_compatible
RAG_EMBEDDER=hashing
RAG_LLM=extractive

# Any OpenAI-compatible endpoint: OpenAI, Mistral (https://api.mistral.ai/v1),
# Ollama (http://host.docker.internal:11434/v1)...
RAG_API_BASE_URL=https://api.openai.com/v1
RAG_API_KEY=
RAG_LLM_MODEL=gpt-4o-mini
